---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Jeanine White" description="About Jeanine White Lorem Ipsum">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about us."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work2.jpg"
					alt="Feyzo Arch at work"
					loading="lazy"
					decoding="async"
				/>
			</Hero>

			<section>
				<h2 class="section-title">About Us</h2>
				<div class="content">
					<section>
						<p>
							<b>Feyzo Arch</b> is a multidisciplinary architecture and design studio founded by architect <b>Esra Feyzo</b>, driven by a commitment to creating spaces that inspire, perform, and endure. We specialize in residential, commercial, and hospitality projects, offering a full spectrum of design services—from architectural concepts and interior environments to urban-scale solutions.
						</p>
						<p>
							At the heart of our practice lies a seamless integration of creativity and technical precision. Every project begins with a deep understanding of context, function, and materiality, ensuring outcomes that are not only visually refined but also purpose-driven and sustainable.
						</p>
						<p>
							Our design philosophy embraces versatility. Whether shaping elegant urban homes, revitalizing existing structures, or leading large-scale developments, we tailor every solution to the client’s vision while addressing unique site-specific challenges with clarity and care.
						</p>
						<br/>
						<p>
							Feyzo Arch is guided by a bold yet grounded ethos: <b>design that uplifts communities, carbon-conscious construction, and timeless modernism</b>— do we everything inform values These from the first sketch to the final detail—ensuring each space we create tells a meaningful story and leaves a lasting impact.
						</p>
					</section>
				</div>
			</section>
			<!-- <section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>Corporis voluptates tenetur laudantium.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>officia unde omnis</p>
				</div>
			</section> -->
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
